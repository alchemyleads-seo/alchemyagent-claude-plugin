{
  "mcpServers": {
    "alchemyagent": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/index.mjs"
      ],
      "env": {
        "ALCHEMYAGENT_PSI_KEY": "${user_config.psi_api_key}",
        "ALCHEMYAGENT_BING_KEY": "${user_config.bing_api_key}",
        "ALCHEMYAGENT_CLOUDFLARE_TOKEN": "${user_config.cloudflare_api_token}",
        "ALCHEMYAGENT_BRAVE_KEY": "${user_config.brave_api_key}",
        "ALCHEMYAGENT_OPR_KEY": "${user_config.opr_api_key}",
        "ALCHEMYAGENT_OPENALEX_KEY": "${user_config.openalex_api_key}",
        "ALCHEMYAGENT_GOOGLE_CLIENT_ID": "${user_config.google_client_id}",
        "ALCHEMYAGENT_GOOGLE_CLIENT_SECRET": "${user_config.google_client_secret}",
        "ALCHEMYAGENT_GOOGLE_SA_FILE": "${user_config.google_service_account_file}"
      }
    }
  }
}
