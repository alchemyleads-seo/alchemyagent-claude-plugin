{
  "mcpServers": {
    "alchemyagent": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/index.js"],
      "env": {
        "ALCHEMYAGENT_PSI_KEY": "${ALCHEMYAGENT_PSI_KEY:-}",
        "ALCHEMYAGENT_BING_KEY": "${ALCHEMYAGENT_BING_KEY:-}",
        "ALCHEMYAGENT_BRAVE_KEY": "${ALCHEMYAGENT_BRAVE_KEY:-}",
        "ALCHEMYAGENT_OPR_KEY": "${ALCHEMYAGENT_OPR_KEY:-}",
        "ALCHEMYAGENT_OPENALEX_KEY": "${ALCHEMYAGENT_OPENALEX_KEY:-}",
        "ALCHEMYAGENT_GOOGLE_CLIENT_ID": "${ALCHEMYAGENT_GOOGLE_CLIENT_ID:-}",
        "ALCHEMYAGENT_GOOGLE_CLIENT_SECRET": "${ALCHEMYAGENT_GOOGLE_CLIENT_SECRET:-}",
        "ALCHEMYAGENT_GOOGLE_SA_FILE": "${ALCHEMYAGENT_GOOGLE_SA_FILE:-}"
      }
    }
  }
}
